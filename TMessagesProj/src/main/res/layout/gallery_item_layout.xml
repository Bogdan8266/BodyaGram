<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Головна картинка -->
    <ImageView
        android:id="@+id/item_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="#E0E0E0" />

    <!-- Затемнення при виборі -->
    <View
        android:id="@+id/selection_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <!-- Іконка відео (знизу зліва) -->
    <LinearLayout
        android:id="@+id/video_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:background="@drawable/msg_round_play_m"
        android:padding="4dp"
        android:layout_margin="4dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <!-- Якщо немає іконки play, використай системну або ic_ab_other -->
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_ab_other"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIDEO"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- ЗОНА ВИБОРУ (Чекбокс справа зверху) -->
    <!-- Ми робимо її трохи більшою (40dp), щоб легше попасти пальцем -->
    <FrameLayout
        android:id="@+id/check_container"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:background="?attr/selectableItemBackgroundBorderless">

        <!-- Сам кружечок/галочка -->
        <ImageView
            android:id="@+id/check_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/msg_check_s"
            android:background="@drawable/circle_background"
            android:padding="4dp"/>
        <!-- circle_background треба створити або використати стандартний drawable -->
    </FrameLayout>

</FrameLayout>